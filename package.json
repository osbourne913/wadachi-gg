{
  "name": "wadachi-gg",
  "version": "1.0.0",
  "description": "Riot Gamesのデータ請求ファイルを、ブラウザの中だけで年表と図にするサイト",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "story": "esbuild scripts/run-story.ts --bundle --platform=node --format=cjs --outfile=.cache/run-story.cjs --log-level=warning && node .cache/run-story.cjs"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@fontsource-variable/figtree": "^5.3.0",
    "@stylexjs/stylex": "^0.19.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
